generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLERK
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum SubledgerType {
  NONE
  CUSTOMER
  SUPPLIER
}

enum SystemAccountKey {
  AR
  AP
  SALES_REVENUE
  GENERAL_EXPENSE
  OPENING_BALANCE_EQUITY
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET_15
  NET_30
  NET_60
}

enum JournalSide {
  DEBIT
  CREDIT
}

enum ItemType {
  GOOD
  SERVICE
}

enum InventoryMovementReason {
  OPENING_BALANCE
  PURCHASE
  SALE
  MANUAL_ADJUSTMENT
}

enum PaymentKind {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
}

model Account {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String
  code            String?
  name            String
  type            AccountType
  parentAccountId String?           @db.Uuid
  subledgerType   SubledgerType     @default(NONE)
  systemKey       SystemAccountKey?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())

  parentAccount    Account?           @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  childAccounts    Account[]          @relation("AccountHierarchy")
  journalLines     JournalEntryLine[]
  customerReceivables Customer[]      @relation("CustomerReceivables")
  supplierPayables    Supplier[]      @relation("SupplierPayables")
  receivedPayments    Payment[]       @relation("PaymentAccount")

  @@unique([userId, code])
  @@unique([userId, systemKey])
  @@index([userId])
  @@index([parentAccountId])
}

model Customer {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String
  name                String
  contactEmail        String?
  contactPhone        String?
  billingAddress      String?
  paymentTerms        PaymentTerms?
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  receivableAccountId String?         @db.Uuid

  receivableAccount Account?          @relation("CustomerReceivables", fields: [receivableAccountId], references: [id], onDelete: Restrict)
  invoices          SalesInvoice[]
  journalLines      JournalEntryLine[]
  payments          Payment[]

  @@index([userId])
  @@index([receivableAccountId])
}

model Supplier {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String
  name             String
  contactEmail     String?
  contactPhone     String?
  billingAddress   String?
  paymentTerms     PaymentTerms?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  payableAccountId String?         @db.Uuid

  payableAccount Account?          @relation("SupplierPayables", fields: [payableAccountId], references: [id], onDelete: Restrict)
  bills          PurchaseBill[]
  journalLines   JournalEntryLine[]
  payments       Payment[]

  @@index([userId])
  @@index([payableAccountId])
}

model Payment {
  id             String      @id @default(uuid()) @db.Uuid
  userId     String
  kind           PaymentKind
  customerId     String?     @db.Uuid
  supplierId     String?     @db.Uuid
  accountId      String      @db.Uuid
  amount         Decimal     @db.Decimal(19, 4)
  paymentDate    DateTime    @default(now())
  reference      String?
  notes          String?
  journalEntryId String      @unique @db.Uuid
  createdAt      DateTime    @default(now())

  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  account      Account      @relation("PaymentAccount", fields: [accountId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([userId, paymentDate])
  @@index([customerId])
  @@index([supplierId])
}

model AppUser {
  id         String   @id @default(uuid()) @db.Uuid
  authUserId String   @unique
  role       UserRole @default(CLERK)
  createdAt  DateTime @default(now())
  @@map("app_users")
}

model Expense {
  id         Int      @id @default(autoincrement())
  name       String
  amount     Float
  userId     String
  createdAt  DateTime @default(now())


  @@index([userId])
}

model Item {
  id             String   @id @default(uuid()) @db.Uuid
  userId          String
  name           String
  type           ItemType
  productCode    String
  description    String?
  unitCost       Decimal? @db.Decimal(19, 4)
  unitPrice      Decimal? @db.Decimal(19, 4)
  quantityOnHand Decimal? @db.Decimal(19, 4)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  movements         InventoryMovement[]
  salesInvoiceLines SalesInvoiceLine[]  @relation("SalesInvoiceLines")
  purchaseBillLines PurchaseBillLine[]  @relation("PurchaseBillLines")

  @@unique([userId, productCode])
  @@index([userId, type])
}

model InventoryMovement {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String
  itemId      String                  @db.Uuid
  quantity    Decimal                 @db.Decimal(19, 4)
  reason      InventoryMovementReason
  referenceId String?
  movementDate DateTime @default(now())
  createdAt   DateTime                @default(now())

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([itemId, createdAt])
}

model SalesInvoice {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String
  customerId    String   @db.Uuid
  invoiceNumber String
  issueDate     DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    SalesInvoiceLine[]

  @@unique([userId, invoiceNumber])
  @@index([userId, issueDate])
  @@index([customerId])
}

model SalesInvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  itemId      String  @db.Uuid
  itemName    String
  productCode String
  quantity    Decimal @db.Decimal(19, 4)
  unitPrice   Decimal @db.Decimal(19, 4)
  lineTotal   Decimal @db.Decimal(19, 4)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item         @relation("SalesInvoiceLines", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([itemId])
}

model PurchaseBill {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String
  supplierId String   @db.Uuid
  billNumber String
  billDate   DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseBillLine[]

  @@unique([userId, billNumber])
  @@index([userId, billDate])
  @@index([supplierId])
}

model PurchaseBillLine {
  id          String  @id @default(uuid()) @db.Uuid
  billId      String  @db.Uuid
  itemId      String  @db.Uuid
  itemName    String
  productCode String
  quantity    Decimal @db.Decimal(19, 4)
  unitCost    Decimal @db.Decimal(19, 4)
  lineTotal   Decimal @db.Decimal(19, 4)

  bill PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  item Item         @relation("PurchaseBillLines", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([itemId])
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  entryDate   DateTime @default(now())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceType  String?
  sourceId    String?

  lines    JournalEntryLine[]
  payment  Payment?

  @@index([userId, entryDate])
  @@unique([userId, sourceType, sourceId])
}

model JournalEntryLine {
  id             String      @id @default(uuid()) @db.Uuid
  userId          String
  journalEntryId  String      @db.Uuid
  accountId       String      @db.Uuid
  customerId     String?     @db.Uuid
  supplierId     String?     @db.Uuid
  side           JournalSide
  amount         Decimal     @db.Decimal(19, 4)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([journalEntryId])
  @@index([accountId])
}
